  "ruleManyPinsBody": "Knock over several pins and you score the number of pins, not their sum.",
  "ruleManyPinsDetail": "Example: knocking over pins 7, 9 and 12 scores 3 points.",
  "ruleLeaningTitle": "Leaning pins don't count",
  "ruleLeaningBody": "A pin resting on another pin or on the stick doesn't count as knocked over.",
  "ruleOvershootTitle": "Don't overshoot",
